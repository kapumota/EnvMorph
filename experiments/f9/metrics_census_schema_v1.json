{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://envmorph.local/schemas/f9-metrics-census-v1.json",
  "title": "EnvMorph F9 observation and intervention census",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "corpus_role", "workloads"],
  "properties": {
    "schema_version": {"const": "f9.metrics_census.v1"},
    "campaign_id": {"type": "string", "minLength": 1},
    "corpus_role": {"enum": ["synthetic", "external"]},
    "workloads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workload_id", "run_id", "workload_status", "observer_effect",
          "graph_file", "graph_sha256", "census_sha256",
          "census_frozen_before_treatment", "census_commit", "plans_commit",
          "candidates"
        ],
        "properties": {
          "workload_id": {"type": "string", "minLength": 1},
          "run_id": {"type": "string", "minLength": 1},
          "workload_status": {"enum": ["completed", "unavailable", "out_of_scope", "observer_failure", "execution_failed"]},
          "observer_effect": {"enum": ["preserved", "altered", "unresolved", "not_evaluated"]},
          "graph_file": {"type": ["string", "null"]},
          "graph_sha256": {"type": ["string", "null"]},
          "census_sha256": {"type": ["string", "null"]},
          "census_frozen_before_treatment": {"type": "boolean"},
          "census_commit": {"type": ["string", "null"]},
          "plans_commit": {"type": ["string", "null"]},
          "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}}
        }
      }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependency_key", "eligibility", "intervention_status",
        "plan_file", "plan_sha256", "plan_frozen_before_treatment",
        "baseline_confirmations", "treatment_confirmations",
        "evidence_file", "evidence_sha256", "classification"
      ],
      "properties": {
        "dependency_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "eligibility": {"enum": ["eligible", "not_intervenable", "unavailable", "out_of_scope"]},
        "intervention_status": {"enum": ["not_attempted", "confirmed", "unresolved", "execution_failed", "unavailable", "out_of_scope", "observer_failure"]},
        "plan_file": {"type": ["string", "null"]},
        "plan_sha256": {"type": ["string", "null"]},
        "plan_frozen_before_treatment": {"type": "boolean"},
        "baseline_confirmations": {"type": "integer", "minimum": 0},
        "treatment_confirmations": {"type": "integer", "minimum": 0},
        "evidence_file": {"type": ["string", "null"]},
        "evidence_sha256": {"type": ["string", "null"]},
        "classification": {"type": ["string", "null"]}
      }
    }
  }
}
