{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://envmorph.local/schemas/f9-dependency-event-v1.json",
  "title": "EnvMorph F9 DependencyEvent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "dependency_key",
    "run_id",
    "source",
    "source_sequence",
    "pid",
    "ppid",
    "kind",
    "resource_type",
    "resource",
    "operation",
    "result",
    "errno"
  ],
  "properties": {
    "schema_version": {
      "const": "f9.dependency_event.v1"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dependency_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "enum": [
        "ptrace",
        "ld_preload_getenv"
      ]
    },
    "source_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "pid": {
      "type": "integer",
      "minimum": 1
    },
    "ppid": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "kind": {
      "enum": [
        "file",
        "executable",
        "environment"
      ]
    },
    "resource_type": {
      "enum": [
        "path",
        "environment_variable"
      ]
    },
    "resource": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "enum": [
        "success",
        "error",
        "present",
        "missing"
      ]
    },
    "errno": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  }
}
